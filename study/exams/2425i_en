/*

    a. [3] A função book_filter recebe uma lista de objetos struct book, organizada em lista ligada não
    intrusiva, formada por nós do tipo struct list_node, sem sentinela. Retorna como valor, um ponteiro para
    um array de ponteiros para cópias dos objetos struct book recebidos na lista, que satisfaçam um critério. A
    verificação do critério é programada na função cujo ponteiro é passado como argumento no parâmetro
    predicate. Essa função retorna true se o objeto que lhe é passado como argumento satisfaz o critério ou
    false no caso contrário. A função book_filter devolve, através do parâmetro book_array_size, o número
    de objetos que satisfazem o critério. Implemente esta função em linguagem C.

*/

struct book **book_filter(struct list_node *list, size_t *book_array_size,
                          bool (*predicate)(struct book *))
{
    size_t count = 0;
    struct list_node *current = list;
    while (current)
    {
        if (predicate((struct book *)current->data))
            count++;
        current = current->next;
    }

    *book_array_size = count;

    struct book **result = malloc(count * sizeof(struct book *));
    current = list;
    size_t i = 0;
    while (current)
    {
        struct book *b = (struct book *)current->data;
        if (predicate(b))
            result[i++] = b;
        current = current->next;
    }

    return result;
}

/*

    b. [2] Implemente a função book_list_free que liberta todos os recursos de memória alocados numa lista
    ligada não intrusiva, formada por nós do tipo struct list_node, sem sentinela, contendo objetos do tipo
    struct book.

*/

void book_list_free(struct list_node *list)
{
    struct list_node *current = list;
    while (current)
    {
        struct list_node *next = current->next;
        free(current->data);
        free(current);
        current = next;
    }
}