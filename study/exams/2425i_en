
/*

    1. [1,5] Programe em linguagem C a função bool check_power2(unsigned int value); que verifica se o valor
    recebido no parâmetro value é uma potência de dois.

*/

bool check_power2(unsigned int value)
{
    int bits = 0;
    while (value > 0)
    {
        if (value & 1)
            bits++;
        value >>= 1;
    }
    return bits == 1;
}

/*

    2. [2] Escreva em linguagem C, a função int date_get_year(const char *date); que retorna em valor
    numérico, o ano inscrito na data recebida em parâmetro, na forma de string. As datas recebidas em parâmetro
    estão sempre formatadas como no seguinte exemplo: ”segunda‐feira, 16‐09‐2024, 12:45:23”.

*/

int date_get_year(const char *date)
{
    int i = 0;
    int year = 0;

    // procurar a primeira vírgula
    while (date[i] != ',')
    {
        i++;
    }

    // saltar ", DD-MM-"
    i += 8;

    year = (date[i] - '0') * 1000 +
           (date[i + 1] - '0') * 100 +
           (date[i + 2] - '0') * 10 +
           (date[i + 3] - '0');

    return year;
}

