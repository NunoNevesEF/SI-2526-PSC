/**
    1. [1,5] Programe em linguagem C a função round_power2 que arredonda o valor recebido no parâmetro value
    para a potência de dois superior mais próxima. No caso do resultado ultrapassar a capacidade de codificação de
    um unsigned int, deve ser assinalado overflow através do parâmetro overflow;
*/

unsigned int round_power2(unsigned int value, bool *overflow)
{
    int highestBitIdx = 0;
    for (int i = 0; i < 32; i++)
    {
        if ((value >> i) & 1)
        {
            highestBitIdx = i;
        }
    }

    if (highestBitIdx == 31)
    {
        *overflow = true;
    }

    return 1 << (highestBitIdx + 1);
}

/**
    2. [2] Escreva em linguagem C, a função is_palindrome que verifica se a string str é um palíndromo. Na
    implementação desta função não deve distinguir letras maiúsculas de letras minúsculas e não deve recorrer a
    qualquer função da biblioteca standard do C. Um palíndromo corresponde a uma palavra ou sequência de
    palavras que se lêem de igual forma da esquerda para a direita ou da direita para a esquerda. Por exemplo, “Ana”
    e “Roma e amor” são palíndromos. A função retorna true se o argumento corresponder a um palíndromo, retorna
    false, caso contrário.

    Iterar pelo array primeiro para saber o número de chars
*/

bool is_palindrome(const char *str)
{

    int size = 0;
    for (int i = 0; str[i] != '\0'; i++)
    {
        size++;
    }

    for (int j = 0; j < size / 2; j++)
    {
        if (str[j] != str[size - j - 1])
        {
            return false;
        }
    }

    return true;
}

