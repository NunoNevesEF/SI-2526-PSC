void *section_copy(void *data)
{
    Section *s = (Section *)data;

    Section *copy = malloc(sizeof(Section));
    copy->id = s->id;
    copy->address = s->address;
    copy->size = s->size;

    copy->content = malloc(s->size);
    memcpy(copy->content, s->content, s->size);

    return copy;
}

Lnode *sections_duplicate(Lnode *sections)
{
    return list_copy_deep(sections, section_copy);
}

void section_free(void *data)
{
    Section *s = (Section *)data;
    free(s->content);
    free(s);
}

void sections_destroy(Lnode *sections)
{
    list_free_deep(sections, section_free);
