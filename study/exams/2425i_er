/*
    7. [6] Considere o tipo struct list_node como elemento de formação de lista ligada, não intrusiva, de ligação
    simples.

*/

typedef struct list_node
{
    struct list_node *link;
    void *data;
} Lnode;

/*

    a) [1,5] Programe a função list_copy_deep que retorna uma cópia da lista recebida no parâmetro list,
    incluindo os elementos de dados. A cópia do elemento de dados é realizada pela função de callback cujo
    ponteiro é recebido no argumento copy.
    Lnode *list_copy_deep(Lnode *list, void *(*copy)(void *));

*/

Lnode *list_copy_deep(Lnode *list, void *(*copy)(void *))
{
    Lnode *new_head = malloc(sizeof(Lnode));
    new_head->data = copy(list->data);
    new_head->link = NULL;

    Lnode *current_new = new_head;
    Lnode *current_old = list->link;

    while (current_old != NULL)
    {
        Lnode *new_node = malloc(sizeof(Lnode));
        new_node->data = copy(current_old->data);
        new_node->link = NULL;

        current_new->link = new_node;
        current_new = new_node;
        current_old = current_old->link;
    }

    return new_head;
}

/*

    b) [1,5] Programe a função list_free_deep que elimina a lista recebida no parâmetro list. Os elementos de
    dados devem ser eliminados através da função de callback cujo ponteiro é recebido no argumento pfree.
    void list_free_deep(Lnode *list, void (*pfree)(void *));

*/

void list_free_deep(Lnode *list, void (*pfree)(void *))
{
    Lnode *current = list;
    while (current != NULL)
    {
        Lnode next = current->link;
        pfree(current->data);
        free(current);
        current = next;
    }
}

